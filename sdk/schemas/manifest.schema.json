{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://moontranslator.dev/schemas/manifest.schema.json",
  "title": "Moon Translator Plugin Manifest",
  "description": "Schema for Moon Translator plugin manifest.json files",
  "type": "object",
  "required": ["name", "version", "type"],
  "properties": {
    "name": {
      "type": "string",
      "description": "Unique plugin name",
      "minLength": 1,
      "maxLength": 64,
      "pattern": "^[a-zA-Z0-9 _\\-]+$"
    },
    "version": {
      "type": "string",
      "description": "Semantic version (e.g. 1.0.0)",
      "pattern": "^\\d+\\.\\d+\\.\\d+(-[a-zA-Z0-9.]+)?$"
    },
    "description": {
      "type": "string",
      "description": "Short description of the plugin",
      "maxLength": 256
    },
    "author": {
      "type": "string",
      "description": "Plugin author name or organization"
    },
    "type": {
      "type": "string",
      "enum": ["translation", "ocr", "tts", "datasource"],
      "description": "Plugin capability type"
    },
    "enabled": {
      "type": "boolean",
      "description": "Whether the plugin is enabled by default",
      "default": true
    },
    "minApiVersion": {
      "type": "integer",
      "description": "Minimum host API version required",
      "minimum": 1,
      "default": 1
    },
    "updateUrl": {
      "type": "string",
      "format": "uri",
      "description": "URL for checking plugin updates"
    },
    "permissions": {
      "type": "array",
      "description": "Permissions this plugin requires",
      "items": {
        "$ref": "#/definitions/Permission"
      },
      "uniqueItems": true
    },
    "sandbox": {
      "$ref": "#/definitions/SandboxConfig"
    },
    "entryPoint": {
      "type": "string",
      "description": "Path to plugin executable (relative to plugin dir), for sandboxed plugins"
    },
    "translation": {
      "$ref": "#/definitions/TranslationConfig"
    },
    "ocr": {
      "$ref": "#/definitions/OcrConfig"
    },
    "tts": {
      "$ref": "#/definitions/TtsConfig"
    },
    "datasource": {
      "$ref": "#/definitions/DatasourceConfig"
    }
  },
  "definitions": {
    "Permission": {
      "type": "string",
      "enum": ["network", "fileRead", "fileWrite", "clipboard", "process", "history", "ocr", "tts"]
    },
    "SandboxConfig": {
      "type": "object",
      "description": "Sandbox resource limits for plugin subprocesses",
      "properties": {
        "enabled": {
          "type": "boolean",
          "default": true
        },
        "maxMemoryMb": {
          "type": "integer",
          "description": "Maximum memory in MB",
          "minimum": 16,
          "maximum": 4096,
          "default": 256
        },
        "maxCpuPercent": {
          "type": "integer",
          "description": "Maximum CPU usage percent (0-100)",
          "minimum": 1,
          "maximum": 100,
          "default": 50
        },
        "maxConnections": {
          "type": "integer",
          "description": "Maximum concurrent network connections",
          "minimum": 1,
          "maximum": 100,
          "default": 10
        },
        "maxRestarts": {
          "type": "integer",
          "description": "Maximum subprocess restarts before giving up",
          "minimum": 0,
          "maximum": 10,
          "default": 3
        }
      }
    },
    "TranslationConfig": {
      "type": "object",
      "description": "Configuration for translation plugins",
      "required": ["endpoint"],
      "properties": {
        "endpoint": {
          "type": "string",
          "format": "uri",
          "description": "HTTP endpoint for translation requests (POST)"
        },
        "supportedLanguages": {
          "type": "array",
          "description": "Supported language pairs. Empty array means all languages supported.",
          "items": {
            "type": "array",
            "items": { "type": "string" },
            "minItems": 2,
            "maxItems": 2
          }
        },
        "headers": {
          "type": "object",
          "description": "Custom HTTP headers sent with every request",
          "additionalProperties": { "type": "string" }
        },
        "supportsStream": {
          "type": "boolean",
          "description": "Whether the plugin supports SSE streaming",
          "default": false
        },
        "supportsBatch": {
          "type": "boolean",
          "description": "Whether the plugin supports batch translation",
          "default": false
        }
      }
    },
    "OcrConfig": {
      "type": "object",
      "description": "Configuration for OCR plugins",
      "required": ["endpoint"],
      "properties": {
        "endpoint": {
          "type": "string",
          "format": "uri",
          "description": "HTTP endpoint for OCR requests (POST)"
        },
        "supportedLanguages": {
          "type": "array",
          "description": "Supported OCR languages. Empty means all.",
          "items": { "type": "string" }
        },
        "supportsDetailed": {
          "type": "boolean",
          "description": "Whether the plugin returns detailed results with bounding boxes",
          "default": false
        }
      }
    },
    "TtsConfig": {
      "type": "object",
      "description": "Configuration for TTS plugins",
      "required": ["endpoint"],
      "properties": {
        "endpoint": {
          "type": "string",
          "format": "uri",
          "description": "HTTP endpoint for TTS requests (POST)"
        },
        "supportedLanguages": {
          "type": "array",
          "description": "Supported TTS languages. Empty means all.",
          "items": { "type": "string" }
        },
        "voices": {
          "type": "array",
          "description": "Available voices",
          "items": {
            "type": "object",
            "required": ["id", "name", "lang"],
            "properties": {
              "id": { "type": "string" },
              "name": { "type": "string" },
              "lang": { "type": "string" },
              "gender": { "type": "string", "enum": ["male", "female", "neutral"] }
            }
          }
        }
      }
    },
    "DatasourceConfig": {
      "type": "object",
      "description": "Configuration for data source plugins (TM, glossary, dictionary)",
      "required": ["endpoint"],
      "properties": {
        "endpoint": {
          "type": "string",
          "format": "uri",
          "description": "HTTP endpoint for data source queries (POST)"
        },
        "capabilities": {
          "type": "array",
          "description": "What data operations the plugin supports",
          "items": {
            "type": "string",
            "enum": ["translate", "lookup", "memory", "glossary"]
          }
        }
      }
    }
  }
}
