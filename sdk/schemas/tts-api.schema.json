{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://moontranslator.dev/schemas/tts-api.schema.json",
  "title": "Moon Translator - TTS Plugin API",
  "description": "Schema for TTS plugin HTTP API request/response",

  "definitions": {
    "TtsRequest": {
      "type": "object",
      "required": ["text"],
      "properties": {
        "text": {
          "type": "string",
          "description": "Text to convert to speech",
          "minLength": 1
        },
        "lang": {
          "type": "string",
          "description": "Language code (e.g. 'en', 'zh', 'ja')"
        },
        "voice": {
          "type": "string",
          "description": "Voice ID to use"
        },
        "speed": {
          "type": "number",
          "description": "Playback speed multiplier (0.5 - 2.0)",
          "minimum": 0.5,
          "maximum": 2.0,
          "default": 1.0
        },
        "format": {
          "type": "string",
          "enum": ["mp3", "wav", "ogg", "aac"],
          "description": "Audio output format",
          "default": "mp3"
        }
      }
    },
    "TtsResponse": {
      "type": "object",
      "required": ["audio"],
      "properties": {
        "audio": {
          "type": "string",
          "description": "Base64-encoded audio data"
        },
        "format": {
          "type": "string",
          "description": "Audio format of the returned data"
        },
        "durationMs": {
          "type": "integer",
          "description": "Audio duration in milliseconds"
        }
      }
    },
    "VoicesResponse": {
      "type": "object",
      "required": ["voices"],
      "properties": {
        "voices": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["id", "name", "lang"],
            "properties": {
              "id": { "type": "string" },
              "name": { "type": "string" },
              "lang": { "type": "string" },
              "gender": { "type": "string", "enum": ["male", "female", "neutral"] }
            }
          }
        }
      }
    },
    "ErrorResponse": {
      "type": "object",
      "required": ["error"],
      "properties": {
        "error": { "type": "string" },
        "code": { "type": "string" }
      }
    }
  }
}
