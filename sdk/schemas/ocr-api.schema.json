{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://moontranslator.dev/schemas/ocr-api.schema.json",
  "title": "Moon Translator - OCR Plugin API",
  "description": "Schema for OCR plugin HTTP API request/response",

  "definitions": {
    "OcrRequest": {
      "type": "object",
      "required": ["image"],
      "properties": {
        "image": {
          "type": "string",
          "description": "Base64-encoded image data"
        },
        "lang": {
          "type": "string",
          "description": "OCR language hint (e.g. 'en', 'zh', 'ja')"
        },
        "detailed": {
          "type": "boolean",
          "description": "Whether to return detailed results with bounding boxes",
          "default": false
        }
      }
    },
    "OcrResponse": {
      "type": "object",
      "required": ["text"],
      "properties": {
        "text": {
          "type": "string",
          "description": "Recognized text from the image"
        },
        "lines": {
          "type": "array",
          "description": "Detailed line-level results (when detailed=true)",
          "items": {
            "$ref": "#/definitions/OcrLine"
          }
        }
      }
    },
    "OcrLine": {
      "type": "object",
      "required": ["text"],
      "properties": {
        "text": {
          "type": "string"
        },
        "boundingBox": {
          "type": "object",
          "properties": {
            "x": { "type": "number" },
            "y": { "type": "number" },
            "width": { "type": "number" },
            "height": { "type": "number" }
          }
        },
        "confidence": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        }
      }
    },
    "ErrorResponse": {
      "type": "object",
      "required": ["error"],
      "properties": {
        "error": { "type": "string" },
        "code": { "type": "string" }
      }
    }
  }
}
