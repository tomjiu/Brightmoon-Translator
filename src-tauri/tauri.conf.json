{
  "productName": "Moon Translator",
  "version": "0.1.0",
  "identifier": "com.moon.translator",
  "build": {
    "beforeDevCommand": "pnpm run dev",
    "devUrl": "http://localhost:5173",
    "beforeBuildCommand": "pnpm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Moon Translator",
        "width": 900,
        "height": 600,
        "minWidth": 700,
        "minHeight": 500,
        "center": true,
        "resizable": true,
        "visible": true,
        "backgroundColor": "#0f1115"
      }
    ],
    "security": {
      "csp": null,
      "assetProtocol": {
        "enable": true,
        "scope": ["$TEMP/**", "$APPDATA/**", "$CACHE/**"]
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/icon.ico"
    ]
  }
}
