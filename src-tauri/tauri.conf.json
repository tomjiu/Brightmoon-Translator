{
  "productName": "Moon Translator",
  "version": "0.2.0",
  "identifier": "com.moon.translator",
  "build": {
    "beforeDevCommand": "pnpm run dev",
    "devUrl": "http://127.0.0.1:5173",
    "beforeBuildCommand": "pnpm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "title": "Moon Translator",
        "width": 900,
        "height": 600,
        "minWidth": 700,
        "minHeight": 500,
        "center": true,
        "resizable": true,
        "decorations": false,
        "visible": true,
        "backgroundColor": "#0a0a0a"
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self' 'unsafe-inline'; style-src 'self' 'unsafe-inline'; img-src 'self' asset: data: https:; connect-src 'self' https: ws: http://127.0.0.1:* http://localhost:*; font-src 'self' data:; object-src 'none'; base-uri 'self'",
      "assetProtocol": {
        "enable": true,
        "scope": ["$TEMP/**", "$APPDATA/**", "$CACHE/**"]
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/icon.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "resources": {
      "bin/moon_hook.dll": "moon_hook.dll",
      "../dictionaries/ecdict.db": "dictionaries/ecdict.db"
    }
  }
}
