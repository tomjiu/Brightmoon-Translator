# Dependencies
node_modules/
.pnp
.pnp.js

# Use pnpm (CI: pnpm install --frozen-lockfile). Ignore other lockfiles.
package-lock.json
yarn.lock
bun.lockb

# Testing
coverage/

# Production
dist/
build/

# Tauri / Rust build artifacts
src-tauri/target/
/target/

# IDE
.vscode/
.idea/
.claude/
*.swp
*.swo
*~

# Editor / agent backup files
*.backup
*.bak
*.orig

# OS
.DS_Store
Thumbs.db

# Env
.env
.env.local
.env.*.local

# Logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# Temp files / agent noise
tmpclaude-*
**/tmpclaude-*
*.tmp
*.temp
nul
pi-session-*.html
.tmp/
.playwright-mcp/
.pi-subagents/
.pi/
docs/superpowers/

# Third party tools
YodaoDict/
dictionaries/

# Local reference dumps (oss clones + commercial UX samples; do not commit)
tmp/

# Local export / agent clutter
github-data/
archive/

# Agent workspace
.workbuddy/

# iOS icon assets (not needed for desktop build)
src-tauri/icons/ios/

# Dev-only example binaries
src-tauri/examples/

# Offline engine spike (throwaway; keep verdict/config reference only)
spike/target/
# Large model binaries (compressed models ~87MB) — keep configs + VERDICT.md in git
spike/bergamot-cjk/*.gz
spike/bergamot-cjk/*.bin
spike/bergamot-cjk/*.spm

# Native bergamot build outputs (built by scripts/build-bergamot-native.ps1).
# Keep the C ABI bridge SOURCE in-repo so a fresh checkout can rebuild; the
# mirrored upstream headers (include/) and compiled libs (lib/, *.obj) are all
# regenerated by the build script.
src-tauri/native/*
!src-tauri/native/bergamot_bridge.cpp
!src-tauri/native/bergamot_bridge.h
